{
  // The server, the shared code, the scripts and the tests that need no DOM: Bun's types, no DOM library, so browser
  // globals in server code fail the type check. Browser code and the tests that need the DOM: tsconfig.web.json.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["index.ts", "server/**/*", "shared/**/*", "scripts/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "test/web/**"]
}
