{
  "_about": "A workflow turn: the Workflow launch card (a can_use_tool for the Workflow tool), then a background workflow task with phases and agents that settles after the turn ends.",
  "turns": [
    {
      "steps": [
        { "say": { "id": "msg_wf_1", "text": "I will run a small workflow.", "tools": [{ "id": "toolu_fake_workflow_1", "name": "Workflow", "input": { "script": "export const meta = { name: 'greet-demo', description: 'Two agents reply with alpha and beta' };" } }] } },
        {
          "ask": {
            "subtype": "can_use_tool",
            "tool_name": "Workflow",
            "input": { "script": "export const meta = { name: 'greet-demo', description: 'Two agents reply with alpha and beta' };" },
            "tool_use_id": "toolu_fake_workflow_1",
            "title": "Claude wants to run the workflow greet-demo",
