{
  "_about": "A question card: Claude calls AskUserQuestion with a single-choice and a multi-select question; the answers come back in updatedInput.",
  "turns": [
    {
      "steps": [
        { "say": { "id": "msg_q_1", "tools": [{ "id": "toolu_fake_question_1", "name": "AskUserQuestion", "input": { "questions": [{ "question": "Which colour should the button be?", "header": "Colour", "multiSelect": false, "options": [{ "label": "Red", "description": "A warm red" }, { "label": "Blue", "description": "A calm blue" }] }, { "question": "Which sizes should ship?", "header": "Sizes", "multiSelect": true, "options": [{ "label": "Small", "description": "" }, { "label": "Medium", "description": "" }, { "label": "Large", "description": "" }] }] } }] } },
        {
          "ask": {
            "subtype": "can_use_tool",
            "tool_name": "AskUserQuestion",
            "input": { "questions": [{ "question": "Which colour should the button be?", "header": "Colour", "multiSelect": false, "options": [{ "label": "Red", "description": "A warm red" }, { "label": "Blue", "description": "A calm blue" }] }, { "question": "Which sizes should ship?", "header": "Sizes", "multiSelect": true, "options": [{ "label": "Small", "description": "" }, { "label": "Medium", "description": "" }, { "label": "Large", "description": "" }] }] },
            "tool_use_id": "toolu_fake_question_1"
          },
          "then": {
            "allow": [
              { "emit": { "type": "user", "message": { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "toolu_fake_question_1", "content": "User has answered your questions.", "is_error": false }] }, "parent_tool_use_id": null } },
              { "say": { "id": "msg_q_2", "text": "Thanks, I have your answers." } },
              { "emit": { "type": "result", "subtype": "success", "result": "Thanks, I have your answers.", "num_turns": 2 } }
            ],
            "deny": [
              { "emit": { "type": "user", "message": { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "toolu_fake_question_1", "content": "The user dismissed the question.", "is_error": true }] }, "parent_tool_use_id": null } },
              { "emit": { "type": "result", "subtype": "success", "result": "", "num_turns": 2 } }
            ]
          }
        }
      ]
    }
  ]
}
